{% extends 'base.html.twig' %}

{% block body %}
<style>
    body {
        background: linear-gradient(135deg, #0f172a, #1e3a8a, #2563eb);
        color: white;
        font-family: 'Poppins', sans-serif;
    }

    .cv-wrapper {
        max-width: 1100px;
        margin: 50px auto;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    /* HEADER */
    .cv-header {
        background: rgba(255, 255, 255, 0.08);
        padding: 50px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .profile-pic {
        width: 180px;
        height: 180px;
        object-fit: cover;
        border-radius: 20px;
        border: 3px solid #60a5fa;
        margin-right: 40px;
    }
    .header-text h1 { font-size: 2.8rem; font-weight: 800; margin: 0; color: white; }
    .header-text h2 { font-size: 1.8rem; color: #93c5fd; margin-bottom: 15px; }
    .header-text p { color: #cbd5e1; max-width: 700px; line-height: 1.6; }

    /* LAYOUT */
    .cv-content { display: flex; }
    
    /* GAUCHE (SIDEBAR) */
    .sidebar {
        width: 35%;
        background: rgba(0, 0, 0, 0.2);
        padding: 40px;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
    .sidebar h3 {
        font-size: 1.1rem;
        text-transform: uppercase;
        color: #60a5fa;
        margin-top: 30px;
        border-left: 4px solid #60a5fa;
        padding-left: 15px;
        letter-spacing: 1px;
    }
    .sidebar ul { list-style: none; padding: 0; margin-top: 15px; }
    .sidebar ul li { margin-bottom: 10px; color: #e2e8f0; font-size: 0.95rem; }

    /* DROITE (MAIN) */
    .main-content { width: 65%; padding: 50px; }
    .section-title {
        font-size: 1.4rem;
        text-transform: uppercase;
        color: #60a5fa;
        margin-bottom: 35px;
        font-weight: bold;
    }
    
    /* TIMELINE STYLE */
    .timeline { border-left: 2px solid rgba(96, 165, 250, 0.3); padding-left: 30px; position: relative; }
    .timeline-item { margin-bottom: 40px; position: relative; }
    .timeline-item::before {
        content: "";
        position: absolute;
        width: 14px;
        height: 14px;
        background: #3b82f6;
        left: -38px;
        top: 6px;
        border-radius: 50%;
        box-shadow: 0 0 10px #3b82f6;
    }
    .exp-header { display: flex; justify-content: space-between; align-items: baseline; }
    .exp-header h4 { color: white; font-size: 1.1rem; margin: 0; }
    .exp-header span { color: #93c5fd; font-weight: 600; font-size: 0.9rem; }
    .exp-sub { color: #60a5fa; margin-bottom: 12px; font-weight: 500; }
    .timeline-item ul li { color: #cbd5e1; font-size: 0.9rem; margin-bottom: 5px; }

    /* BOUTON SÉCURISÉ */
    .download-btn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 12px 25px;
        border-radius: 12px;
        color: #93c5fd;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
        display: inline-block;
    }
    .download-btn:hover { 
        background: #2563eb; 
        color: white; 
        transform: scale(1.05); 
        box-shadow: 0 0 20px rgba(37, 99, 235, 0.4); 
    }
</style>

<div class="container">
    <div class="cv-wrapper">
        <div class="cv-header">
            <img src="{{ asset('photo.png') }}" class="profile-pic" alt="Fatou Binetou Diallo">
            <div class="header-text">
                <h1>FATOU BINETOU DIALLO</h1>
                <h2>RECHERCHE D'ALTERNANCE</h2>
                <p>Passionnée par les infrastructures réseaux, la cybersécurité et l'administration système. Actuellement en BUT R&T, je recherche une alternance de 24 mois pour mettre mes compétences au service de votre infrastructure.</p>
            </div>
        </div>

        <div class="cv-content">
            <div class="sidebar">
                <h3>Contact</h3>
                <ul>
                    <li>📧 dfatoubintou400@gmail.com</li>
                    <li>🪪 Permis B</li>
                    <li>📍 42300, ROANNE</li>
                </ul>

                <h3>Compétences Techniques</h3>
                <ul>
                    <li>Réseaux (Cisco, OSPF, RIP)</li>
                    <li>Infrastructures & Câblage</li>
                    <li>Systèmes (Linux, Windows Server)</li>
                    <li>Sécurité (ACL, NAT, VPN)</li>
                    <li>Outils (Docker, Wireshark)</li>
                </ul>

                <h3>Soft Skills</h3>
                <ul>
                    <li>Communication & Collaboration</li>
                    <li>Adaptabilité</li>
                    <li>Rigueur & Organisation</li>
                </ul>

                <h3>Langues</h3>
                <ul>
                    <li>Français (Courant)</li>
                    <li>Anglais (Technique)</li>
                </ul>

                <div class="mt-5">
                    {# Redirection vers la page contact avec un paramètre d'identification #}
                    <a href="{{ path('contact', {'auth': 'required'}) }}" class="download-btn">
                         S'identifier pour télécharger
                    </a>
                </div>
            </div>

            <div class="main-content">
                <div class="section-title">Expérience Professionnelle</div>
                
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="exp-header">
                            <h4>Projet Réseaux (SAE - IUT)</h4>
                            <span>2025-2026</span>
                        </div>
                        <ul>
                            <li>Sécurisation et supervision d'infrastructures</li>
                            <li>Installation et configuration de serveurs WEB</li>
                            <li>Analyse de trames et traitement de données réseau</li>
                        </ul>
                    </div>

                    <div class="timeline-item">
                        <div class="exp-header">
                            <h4>Campus Solidaire</h4>
                            <span>2025 - Présent</span>
                        </div>
                        <div class="exp-sub">Responsable Événementiel</div>
                        <ul>
                            <li>Coordination logistique de projets solidaires</li>
                            <li>Animation d'équipe et communication externe</li>
                        </ul>
                    </div>

                    <div class="timeline-item">
                        <div class="exp-header">
                            <h4>JFMI - Bénévolat</h4>
                            <span>Déc. 2025</span>
                        </div>
                        <ul>
                            <li>Atelier de création web pour collégiennes</li>
                            <li>Promotion des métiers du numérique</li>
                        </ul>
                    </div>
                </div>

                <div class="section-title mt-5">Formations</div>
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="exp-header">
                            <h4>BUT Réseaux & Télécommunications</h4>
                            <span>2025-2026</span>
                        </div>
                        <div class="exp-sub">IUT de Roanne</div>
                    </div>
                    <div class="timeline-item">
                        <div class="exp-header">
                            <h4>Baccalauréat Scientifique</h4>
                            <span>2024-2025</span>
                        </div>
                        <div class="exp-sub">Sénégal</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}