{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="vh-100 d-flex align-items-center justify-content-center">
    <main class="container shadow-lg p-5 text-center text-white" style="background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(10px); border-radius: 20px;">
        <h1 class="display-2 fw-bold mb-3">Bienvenue</h1>
        <p class="lead fs-3 mb-4">Étudiante en Réseaux et Télécommunications</p>
        
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a href="{{ path('portfolio') }}" class="btn btn-primary btn-lg px-5 shadow">Mes projets</a>
            <a href="{{ path('contact') }}" class="btn btn-outline-light btn-lg px-5">Contact</a>
        </div>
    </main>
</div>
{% endblock %}