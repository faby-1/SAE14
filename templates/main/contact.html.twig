{% extends 'base.html.twig' %}

{% block title %}Contact - Fatou Binetou Diallo{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(135deg, #0f172a, #1e3a8a, #2563eb);
        color: white;
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
    }

    .contact-container {
        max-width: 800px;
        margin: 80px auto;
        padding: 20px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 30px;
        padding: 40px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .section-title {
        color: #60a5fa;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 30px;
        text-align: center;
    }

    .form-label {
        color: #93c5fd;
        font-weight: 500;
        margin-top: 15px;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 12px;
        padding: 12px;
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #60a5fa;
        color: white;
        box-shadow: 0 0 10px rgba(96, 165, 250, 0.3);
    }

    .btn-submit {
        background: linear-gradient(to right, #2563eb, #60a5fa);
        border: none;
        border-radius: 12px;
        padding: 15px;
        font-weight: 700;
        width: 100%;
        margin-top: 30px;
        transition: 0.3s;
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(37, 99, 235, 0.4);
    }

    .alert-auth {
        background: rgba(37, 99, 235, 0.2);
        border: 1px solid #60a5fa;
        border-radius: 15px;
        color: #dbeafe;
        padding: 15px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
    }
</style>

<div class="container contact-container">
    {% if app.request.query.get('auth') == 'required' %}
        <div class="alert-auth animate__animated animate__fadeInDown">
            <span class="me-3" style="font-size: 1.5rem;">🔒</span>
            <div>
                <strong>Accès sécurisé :</strong> Veuillez vous identifier ou laisser vos coordonnées pour accéder au téléchargement de mon CV complet.
            </div>
        </div>
    {% endif %}

    <div class="glass-card">
        <h2 class="section-title">ME CONTACTER</h2>
        
        <form action="#" method="POST">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Nom complet</label>
                    <input type="text" class="form-control" placeholder="Ex: Jean Dupont" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email Professionnel</label>
                    <input type="email" class="form-control" placeholder="email@entreprise.fr" required>
                </div>
            </div>

            <div class="mt-3">
                <label class="form-label">Objet</label>
                <input type="text" class="form-control" placeholder="Demande d'alternance / Collaboration">
            </div>

            <div class="mt-3">
                <label class="form-label">Message</label>
                <textarea class="form-control" rows="5" placeholder="Votre message ici..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-submit">
                ENVOYER LE MESSAGE
            </button>
        </form>
    </div>
</div>
{% endblock %}